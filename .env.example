# CityCost CLI Environment Configuration
# Copy this file to .env and adjust variables as needed

# Fetcher mode: auto (default: direct first, fetcher fallback on block) | always | never
CITYCOST_FETCH_MODE=auto

# Optional external fetcher shell command template for GET requests ({url} placeholder required)
# CITYCOST_FETCH_CMD="curl -s '{url}'"

# Optional external fetcher shell command template for POST requests (request body via stdin)
# CITYCOST_POST_CMD="curl -s -X POST -H 'Content-Type: application/json' --data-binary @- '{url}'"

# Custom directory for caching HTML and parsed city data (defaults to ~/.cache/citycost)
# CITYCOST_CACHE_DIR=~/.cache/citycost

# Minimum interval between outgoing requests in seconds (cannot lower built-in host floor)
# CITYCOST_MIN_INTERVAL=2.5

# Custom config file path override (defaults to ~/.config/citycost/config.ini)
# CITYCOST_CONFIG=~/.config/citycost/config.ini
